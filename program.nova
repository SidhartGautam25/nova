make int x = 15;

if (x > 10) {
    print("x is greater than 10\n");
} else if (x == 10) {
    print("x is 10\n");
} else {
    print("x is less than 10\n");
}

make int count = 0;
while (count < 5) {
    count = count + 1;
    if (count == 2) {
        continue;
    }
    if (count == 4) {
        break;
    }
    print(count);
}
print("\n");

make int r = 0;
make int t = 10;
run t times {
    r = r + 1;
    if (r == 3) {
        break;
    }
}
print("Loop broke at: ");
print(r);
print("\n");

make function multiply(int a, int b) : int {
    make int total = 0;
    run b times {
        total = total + a;
    }
    return total;
}

make int product = multiply(6, 7);
print("Function multiply(6, 7) = ");
print(product);
print("\n");

make char initial = 'N';
make bool verified = true;
print("Grade character: ");
print(initial);
print("\nVerified flag: ");
print(verified);
print("\n");
